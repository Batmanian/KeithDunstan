{% set pageTags = tags | filterTagList | sort %}

{% macro relatedTopicsList() %}
  <ul class="topic-jump-list list-unstyled small text-muted mb-3">
    {%- for tag in pageTags %}
    {% set tagUrl %}/topic/{{ tag | slug }}/{% endset %}
    <li class="topic-jump-item">
      <a href="{{ tagUrl | url | safe }}" class="link-secondary">{{ tag }}</a>
      <a href="#" class="topic-jump-link" data-topic-jump="{{ tag }}">Jump to &rarr;</a>
    </li>
    {%- endfor %}
  </ul>
{% endmacro %}

<!-- Desktop only — unchanged from before. Mobile gets its own, differently
ordered version below (see postcontent.njk for the mobile summary, which
moves up into the article header there instead of appearing here). -->
<div class="bg-light p-4 rounded d-none d-md-block">
  <p class="lead">
        {{ summary }}
      </p>
{% if sections %}
<hr>
<h4 class="h6">In this chapter</h4>
<ul class="list-unstyled small text-muted mb-3">
  {%- for section in sections | uniqueSections %}
  <li><a href="#{{ section.anchor }}" class="link-secondary">{{ section.title }}</a></li>
  {%- endfor %}
</ul>
{% endif %}
{% if pageTags.length %}
<hr>
<h4 class="h6">Topics in this item</h4>
{{ relatedTopicsList() }}
{% endif %}

<br>
<hr>
<small><a href="{{ '/search/' | url }}" >View all topics</a></small>

</div>

<!-- Mobile only — related topics + view all topics, positioned after the
article content; last updated trails at the very end. -->
<div class="d-md-none">
  {% if sections %}
  <h4 class="h6">In this chapter</h4>
  <ul class="list-unstyled small text-muted mb-3">
    {%- for section in sections | uniqueSections %}
    <li><a href="#{{ section.anchor }}" class="link-secondary">{{ section.title }}</a></li>
    {%- endfor %}
  </ul>
  {% endif %}
  {% if pageTags.length %}
  <h4 class="h6">Related topics</h4>
  {{ relatedTopicsList() }}
  {% endif %}
  <small><a href="{{ '/search/' | url }}">View all topics</a></small>

  {% set lastUpdated = page.inputPath | gitLastUpdated %}
  {% if lastUpdated %}
    <p class="text-muted small mt-3 mb-0">
      Last updated <time datetime="{{ lastUpdated | htmlDateString }}">{{ lastUpdated | readableDate }}</time>
    </p>
  {% endif %}
</div>

{% if pageTags.length %}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var articleBody = document.querySelector('.article-body');
    if (!articleBody) return;

    // Every topic's first occurrence is located and wrapped once up front
    // (settled/invisible, see .topic-jump-highlight--settled) rather than
    // per click. This lets a topic with no literal match in this article's
    // text — a tag's canonical spelling doesn't always match Keith
    // Dunstan's prose verbatim, e.g. tag "6 Oclock swill" vs body text
    // "six o'clock swill" — have its "Jump to" link hidden instead of
    // sitting there doing nothing when clicked.
    var marksByTopic = {};
    document.querySelectorAll('[data-topic-jump]').forEach(function (link) {
      var topic = link.getAttribute('data-topic-jump');
      if (!(topic in marksByTopic)) {
        marksByTopic[topic] = wrapFirstMatch(topic);
        if (marksByTopic[topic]) {
          marksByTopic[topic].classList.add('topic-jump-highlight--settled');
        }
      }

      var mark = marksByTopic[topic];
      if (!mark) {
        link.remove();
        return;
      }

      link.addEventListener('click', function (event) {
        event.preventDefault();
        mark.scrollIntoView({ behavior: 'smooth', block: 'center' });
        flash(mark);
      });
    });

    // Re-triggers the fade-out animation on repeat clicks by removing the
    // settled state, forcing a reflow, then re-adding it.
    function flash(mark) {
      mark.classList.remove('topic-jump-highlight--settled');
      void mark.offsetWidth;
      setTimeout(function () {
        mark.classList.add('topic-jump-highlight--settled');
      }, 50);
    }

    // Finds the first case-insensitive occurrence of the topic text in the
    // article body and wraps it in a <mark> so it can be scrolled to and
    // highlighted, without disturbing surrounding markup. Returns null if
    // the topic's exact text doesn't appear in the body.
    function wrapFirstMatch(topic) {
      var needle = topic.toLowerCase();
      var walker = document.createTreeWalker(articleBody, NodeFilter.SHOW_TEXT, {
        acceptNode: function (node) {
          var parentTag = node.parentElement && node.parentElement.tagName;
          if (parentTag === 'SCRIPT' || parentTag === 'STYLE') {
            return NodeFilter.FILTER_REJECT;
          }
          if (!node.nodeValue || node.nodeValue.toLowerCase().indexOf(needle) === -1) {
            return NodeFilter.FILTER_SKIP;
          }
          return NodeFilter.FILTER_ACCEPT;
        }
      });

      var textNode = walker.nextNode();
      if (!textNode) return null;

      var text = textNode.nodeValue;
      var index = text.toLowerCase().indexOf(needle);
      if (index === -1) return null;

      var before = document.createTextNode(text.slice(0, index));
      var after = document.createTextNode(text.slice(index + topic.length));
      var mark = document.createElement('mark');
      mark.className = 'topic-jump-highlight';
      mark.setAttribute('data-topic', topic);
      mark.textContent = text.slice(index, index + topic.length);

      var parent = textNode.parentNode;
      parent.insertBefore(before, textNode);
      parent.insertBefore(mark, textNode);
      parent.insertBefore(after, textNode);
      parent.removeChild(textNode);

      return mark;
    }
  });
</script>
{% endif %}

