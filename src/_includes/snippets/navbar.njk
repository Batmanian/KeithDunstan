<script>
  document.addEventListener('DOMContentLoaded', function () {
    var toggle = document.getElementById('theme-toggle');
    var sunIcon = document.getElementById('theme-toggle-sun');
    var moonIcon = document.getElementById('theme-toggle-moon');
    if (!toggle || !sunIcon || !moonIcon) return;

    var themeColorMeta = document.querySelector('meta[name="theme-color"]');

    function applyIcons(theme) {
      // Sun is shown in dark mode (click to go light); moon in light mode (click to go dark).
      sunIcon.style.display = theme === 'dark' ? '' : 'none';
      moonIcon.style.display = theme === 'dark' ? 'none' : '';
      if (themeColorMeta) {
        themeColorMeta.setAttribute('content', theme === 'dark' ? '#212529' : '#ffffff');
      }
    }

    applyIcons(document.documentElement.getAttribute('data-bs-theme') || 'light');

    toggle.addEventListener('click', function () {
      var next = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-bs-theme', next);
      localStorage.setItem('theme', next);
      applyIcons(next);
    });
  });
</script>
