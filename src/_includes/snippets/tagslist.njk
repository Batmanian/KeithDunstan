{%- set shownTags = [] %}
{%- for tag in collections.tagList %}
  {%- if tag.tagCount > 3 %}
    {%- set _ = shownTags.push(tag) %}
  {%- endif %}
{%- endfor %}
<p class="text-muted mb-4">{{ shownTags.length }} topics, sized by how often they appear.</p>
<div class="tag-cloud">
  {%- for tag in shownTags %}
    {%- set tagUrl %}{{ '/topic/' | url }}{{ tag.tagName | slug }}/{% endset -%}
    {%- if tag.tagCount >= 7 -%}
      {%- set tagSize = "fs-3 fw-semibold" -%}
    {%- elif tag.tagCount >= 5 -%}
      {%- set tagSize = "fs-4 fw-semibold" -%}
    {%- elif tag.tagCount >= 4 -%}
      {%- set tagSize = "fs-5" -%}
    {%- elif tag.tagCount >= 2 -%}
      {%- set tagSize = "fs-6" -%}
    {%- else -%}
      {%- set tagSize = "fs-6 text-muted" -%}
    {%- endif %}
    <a href="{{ tagUrl | safe }}" class="link-dark text-decoration-none d-inline-block me-3 mb-2 {{ tagSize }}" title="{{ tag.tagCount }} item{% if tag.tagCount != 1 %}s{% endif %} include{% if tag.tagCount == 1 %}s{% endif %} this topic">{{ tag.tagName }}</a>
  {%- endfor %}
</div>
