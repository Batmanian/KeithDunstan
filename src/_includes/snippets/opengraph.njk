{#
  Site-wide document metadata: charset/viewport/title/description plus Open
  Graph, Twitter Card and canonical link tags, generated by the
  {% metagen %} shortcode from eleventy-plugin-metagen (registered in
  .eleventy.js).

  Any page can override a field simply by setting the matching frontmatter
  key (title, summary, description, image, imageAlt, ogType). Where a page
  has nothing to say — a listing page, the homepage, an index — everything
  falls back to src/_data/metadata.json, so no page is ever missing OG tags.
#}
{#- The {% metagen %} shortcode below returns raw HTML rather than going
   through Nunjucks' normal auto-escaping {{ }} output, so any field that
   can contain a quote or ampersand — a summary quoting the original
   headline, a title like '£7000 for "Divinely Dressed Ladies"' — has to be
   escaped by hand here, or it silently truncates the HTML attribute and
   corrupts the rest of the <head>. #}
{%- set ogTitle = (title or metadata.title) | escape -%}
{%- set ogDesc = (summary or description or metadata.description) | escape -%}
{%- set ogImage = image or metadata.image -%}
{%- set ogType = ogType or ("article" if date else "website") -%}
{% metagen
  title=ogTitle,
  desc=ogDesc,
  url=metadata.url + page.url,
  img=metadata.url + ogImage,
  img_alt=(imageAlt | escape) if imageAlt else ogTitle,
  name=metadata.author,
  generator="11straps",
  site_name=metadata.title,
  locale=metadata.locale,
  type=ogType,
  twitter_card_type="summary_large_image"
%}
{#- Not an Open Graph property — og:locale is a strict language_TERRITORY
   code (kept above as en_AU) and has nothing to do with place. These are
   the standard geo meta tags for saying where the content is from: Keith
   was Melbourne-based his whole career, so this applies site-wide. #}
<meta name="geo.placename" content="{{ metadata.geoPlacename }}">
<meta name="geo.region" content="{{ metadata.geoRegion }}">
{%- if ogType == "article" %}
{#- eleventy-plugin-metagen has no support for the OG "article" namespace
   (published_time / author / section / tag), so the original publication
   date — the whole point of this archive — never made it into the OG data.
   Added by hand here; same date/publication logic postcontent.njk already
   uses for the on-page byline. #}
<meta property="article:published_time" content="{{ page.date | htmlDateString }}">
<meta property="article:author" content="{{ metadata.author }}">
{%- set publication = categories[0] if categories and categories.length else (page.url | split('/'))[2] | humanizeSlug %}
{%- if publication %}
<meta property="article:section" content="{{ publication }}">
{%- endif %}
{%- for tag in tags | filterTagList %}
<meta property="article:tag" content="{{ tag }}">
{%- endfor %}
{%- endif %}
