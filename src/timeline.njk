---
layout: layouts/default.njk
title: Timeline
titleClass: h2 mb-2
---

<p class="text-muted">Every transcribed article in the archive, alongside Keith Dunstan's published books and key life events, in the order they appeared &mdash; from his birth through to his final columns in The Age.<br> Select a linked entry to read it in full.</p>

<div class="mb-3">
  <div class="timeline-legend d-flex flex-wrap gap-3 small text-muted mb-2" role="group" aria-label="Filter by publication">
    <button type="button" class="timeline-legend-item" data-filter="the-age" aria-pressed="true"><span class="timeline-legend-dot timeline-pub-the-age"></span>The Age</button>
    <button type="button" class="timeline-legend-item" data-filter="the-bulletin" aria-pressed="true"><span class="timeline-legend-dot timeline-pub-the-bulletin"></span>The Bulletin</button>
    <button type="button" class="timeline-legend-item" data-filter="walkabout-magazine" aria-pressed="true"><span class="timeline-legend-dot timeline-pub-walkabout-magazine"></span>Walkabout Magazine</button>
    <button type="button" class="timeline-legend-item" data-filter="other" aria-pressed="true"><span class="timeline-legend-dot timeline-pub-other"></span>The Australian Gourmet</button>
    <button type="button" class="timeline-legend-item" data-filter="book" aria-pressed="true"><span class="timeline-legend-dot timeline-legend-dot--book"></span>Book</button>
    <button type="button" class="timeline-legend-item" data-filter="keiths-life" aria-pressed="true"><span class="timeline-legend-dot timeline-pub-keiths-life"></span>Keith's Life</button>
  </div>
  <div class="d-flex align-items-center gap-2">
    <label for="timeline-sort" class="form-label small text-muted mb-0 text-nowrap">Sort by</label>
    <select id="timeline-sort" class="form-select form-select-sm" style="max-width: 12rem;">
      <option value="date-asc" selected>Date, oldest first</option>
      <option value="date-desc">Date, newest first</option>
      <option value="publication">Publication</option>
      <option value="title">Title, A&ndash;Z</option>
    </select>
    <button type="button" class="timeline-legend-reset small text-muted ms-auto">Reset</button>
  </div>
</div>

<div class="timeline my-4" id="timeline-list">
  {% for item in collections.timeline %}
  {% set pubSlug = item.publication | slug %}
  {% set knownPub = pubSlug in ['the-age', 'the-bulletin', 'walkabout-magazine', 'keiths-life'] %}
  {% set filterSlug = 'book' if item.isBook else (pubSlug if knownPub else 'other') %}
  <div
    class="timeline-item timeline-pub-{{ filterSlug }}{% if item.isBook %} timeline-item--book{% endif %}"
    data-date="{{ item.date | htmlDateString }}"
    data-publication="{{ item.publication }}"
    data-pub-slug="{{ filterSlug }}"
    data-title="{{ item.title }}">
    <span class="timeline-dot" aria-hidden="true"></span>
    {% if item.url %}
    <a
      href="{{ item.url if item.external else (item.url | url) }}"
      class="timeline-card">
    {% else %}
    <span class="timeline-card">
    {% endif %}
      <time class="timeline-date" datetime="{{ item.date | htmlDateString }}">{% if item.isBook or item.yearOnly %}{{ item.date | postDate(['book']) }}{% else %}{{ item.date | readableDate }}{% endif %}</time>
      <span class="timeline-title">{{ item.title }}</span>
      <span class="badge timeline-badge rounded-pill fw-normal">{{ item.publication }}</span>
    {% if item.url %}</a>{% else %}</span>{% endif %}
    {% if item.summary %}
      <p class="timeline-summary text-muted small mb-0">{{ item.summary }}</p>
    {% endif %}
  </div>
  {% endfor %}
</div>

<style>
  /* Categorical palette, validated with the data-viz skill's validator
     (scripts/validate_palette.js) for CVD-safety and surface contrast in
     both colour modes — blue/orange/green pass every check at any two
     colours adjacent (the realistic case here, since entries are date-sorted
     rather than grouped); pink is reserved for books, kept visually distinct
     from the three masthead colours. Orange and pink get darker steps under
     dark mode to stay inside the lightness band for a dark surface; blue and
     green already clear both bands unchanged. Every colour is a secondary
     cue only — the publication name is always shown as text alongside it. */
  :root {
    --tl-the-age: #0072b2;
    --tl-the-bulletin: #e69f00;
    --tl-walkabout-magazine: #009e73;
    --tl-book: #cc79a7;
    --tl-keiths-life: #7c3aed;
    --tl-other: var(--bs-secondary-color);
  }
  [data-bs-theme="dark"] {
    --tl-the-bulletin: #bf7d12;
    --tl-book: #a85589;
    --tl-keiths-life: #6d28d9;
  }
  .timeline {
    position: relative;
    padding-left: 2rem;
    border-left: 2px solid var(--bs-border-color);
  }
  .timeline-item {
    position: relative;
    padding-bottom: 2rem;
  }
  .timeline-item:last-child {
    padding-bottom: 0;
  }
  .timeline-item--hidden {
    display: none;
  }
  .timeline-dot {
    position: absolute;
    top: 0.3rem;
    left: -2.4rem;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background-color: var(--tl-other);
    border: 3px solid var(--bs-body-bg);
    box-shadow: 0 0 0 2px var(--bs-border-color);
  }
  .timeline-pub-the-age .timeline-dot { background-color: var(--tl-the-age); }
  .timeline-pub-the-bulletin .timeline-dot { background-color: var(--tl-the-bulletin); }
  .timeline-pub-walkabout-magazine .timeline-dot { background-color: var(--tl-walkabout-magazine); }
  .timeline-pub-book .timeline-dot { background-color: var(--tl-book); }
  .timeline-pub-keiths-life .timeline-dot { background-color: var(--tl-keiths-life); }
  .timeline-card {
    display: inline-block;
    text-decoration: none;
    color: inherit;
  }
  .timeline-card:hover .timeline-title,
  .timeline-card:focus .timeline-title {
    text-decoration: underline;
  }
  .timeline-pub-the-age .timeline-card:hover .timeline-title,
  .timeline-pub-the-age .timeline-card:focus .timeline-title { color: var(--tl-the-age); }
  .timeline-pub-the-bulletin .timeline-card:hover .timeline-title,
  .timeline-pub-the-bulletin .timeline-card:focus .timeline-title { color: var(--tl-the-bulletin); }
  .timeline-pub-walkabout-magazine .timeline-card:hover .timeline-title,
  .timeline-pub-walkabout-magazine .timeline-card:focus .timeline-title { color: var(--tl-walkabout-magazine); }
  .timeline-pub-book .timeline-card:hover .timeline-title,
  .timeline-pub-book .timeline-card:focus .timeline-title { color: var(--tl-book); }
  .timeline-pub-keiths-life .timeline-card:hover .timeline-title,
  .timeline-pub-keiths-life .timeline-card:focus .timeline-title { color: var(--tl-keiths-life); }
  .timeline-pub-other .timeline-card:hover .timeline-title,
  .timeline-pub-other .timeline-card:focus .timeline-title { color: var(--tl-other); }
  .timeline-date {
    display: block;
    font-size: 0.85rem;
    color: var(--bs-secondary-color);
  }
  .timeline-title {
    display: block;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .timeline-badge {
    background: transparent;
    border: 1px solid currentColor;
    color: var(--tl-other);
  }
  .timeline-pub-the-age .timeline-badge { color: var(--tl-the-age); }
  .timeline-pub-the-bulletin .timeline-badge { color: var(--tl-the-bulletin); }
  .timeline-pub-walkabout-magazine .timeline-badge { color: var(--tl-walkabout-magazine); }
  .timeline-pub-book .timeline-badge { color: var(--tl-book); }
  .timeline-pub-keiths-life .timeline-badge { color: var(--tl-keiths-life); }
  .timeline-summary {
    margin-top: 0.25rem;
    max-width: 40rem;
  }
  .timeline-item--book .timeline-dot {
    width: 1.1rem;
    height: 1.1rem;
    left: -2.55rem;
  }
  .timeline-item--book .timeline-date {
    font-weight: 600;
  }
  .timeline-item--book .timeline-title {
    font-size: 1.25rem;
    font-weight: 700;
  }
  .timeline-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 0;
    background: none;
    padding: 0;
    margin: 0;
    font-size: inherit;
    font-family: inherit;
    color: var(--bs-secondary-color);
    cursor: pointer;
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: opacity 0.15s ease;
  }
  .timeline-legend-item[aria-pressed="false"] {
    opacity: 0.4;
  }
  .timeline-legend-item:hover,
  .timeline-legend-item:focus-visible {
    color: var(--bs-body-color);
  }
  .timeline-legend-reset {
    border: 0;
    background: none;
    padding: 0;
    margin: 0;
    text-decoration: underline;
    cursor: pointer;
  }
  .timeline-legend-dot {
    display: inline-block;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
  }
  .timeline-legend-dot.timeline-pub-the-age { background-color: var(--tl-the-age); }
  .timeline-legend-dot.timeline-pub-the-bulletin { background-color: var(--tl-the-bulletin); }
  .timeline-legend-dot.timeline-pub-walkabout-magazine { background-color: var(--tl-walkabout-magazine); }
  .timeline-legend-dot.timeline-pub-keiths-life { background-color: var(--tl-keiths-life); }
  .timeline-legend-dot.timeline-pub-other { background-color: var(--tl-other); }
  .timeline-legend-dot--book {
    width: 0.9rem;
    height: 0.9rem;
    background-color: var(--tl-book);
  }
</style>

<script>
  (function () {
    var select = document.getElementById('timeline-sort');
    var list = document.getElementById('timeline-list');
    var legend = document.querySelector('.timeline-legend');
    var resetButton = legend ? legend.querySelector('.timeline-legend-reset') : null;
    if (!list) return;

    var sorters = {
      'date-asc': function (a, b) { return a.dataset.date.localeCompare(b.dataset.date); },
      'date-desc': function (a, b) { return b.dataset.date.localeCompare(a.dataset.date); },
      'publication': function (a, b) {
        return a.dataset.publication.localeCompare(b.dataset.publication) ||
          a.dataset.date.localeCompare(b.dataset.date);
      },
      'title': function (a, b) {
        return a.dataset.title.localeCompare(b.dataset.title, undefined, { sensitivity: 'base' });
      }
    };

    if (select) {
      select.addEventListener('change', function () {
        var sorter = sorters[select.value];
        if (!sorter) return;
        var items = Array.prototype.slice.call(list.querySelectorAll('.timeline-item'));
        items.sort(sorter).forEach(function (item) { list.appendChild(item); });
      });
    }

    if (legend) {
      var filterButtons = Array.prototype.slice.call(legend.querySelectorAll('[data-filter]'));
      var activeFilters = filterButtons.map(function (button) { return button.dataset.filter; });

      function applyFilters() {
        list.querySelectorAll('.timeline-item').forEach(function (item) {
          item.classList.toggle('timeline-item--hidden', activeFilters.indexOf(item.dataset.pubSlug) === -1);
        });
      }

      filterButtons.forEach(function (button) {
        button.addEventListener('click', function () {
          var filter = button.dataset.filter;
          activeFilters = [filter];
          filterButtons.forEach(function (other) {
            other.setAttribute('aria-pressed', other.dataset.filter === filter ? 'true' : 'false');
          });
          applyFilters();
        });
      });

      if (resetButton) {
        resetButton.addEventListener('click', function () {
          activeFilters = filterButtons.map(function (button) { return button.dataset.filter; });
          filterButtons.forEach(function (button) { button.setAttribute('aria-pressed', 'true'); });
          applyFilters();
        });
      }
    }
  })();
</script>
