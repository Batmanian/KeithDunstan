---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ metadata.title }}</title>
  <link>{{ metadata.url }}/</link>
  <atom:link href="{{ metadata.url }}/feed.xml" rel="self" type="application/rss+xml"/>
  <description>{{ metadata.description }}</description>
  <language>{{ metadata.language }}</language>
  <generator>Eleventy</generator>
  {%- for item in collections.recentContent %}
  <item>
    <title>{{ item.title }}</title>
    <link>{{ metadata.url }}{{ item.url }}</link>
    <guid isPermaLink="true">{{ metadata.url }}{{ item.url }}</guid>
    <pubDate>{{ item.dateAdded | dateToRfc822 }}</pubDate>
    <description>{{ item.summary }}</description>
  </item>
  {%- endfor %}
</channel>
</rss>
